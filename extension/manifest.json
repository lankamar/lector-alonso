{
  "manifest_version": 3,
  "name": "Lector Alonso",
  "version": "1.8.0",
  "description": "Lee texto seleccionado con la voz de Alonso.",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "commands",
    "contextMenus",
    "offscreen",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lector Alonso",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Leer el texto seleccionado"
    },
    "pause-reading": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pausar o reanudar la lectura"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Detener la lectura"
    }
  }
}
